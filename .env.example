# ==============================================================================
# TCET Lab Lending & Inventory Management Platform - Environment Variables
# ==============================================================================

# Neon PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?sslmode=require
NEON_BRANCH=production

# Spring Boot Application Profile & Ports
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT / Session Security Configuration
JWT_SECRET=your-256-bit-secret-key-here-min-32-characters-long
JWT_EXPIRATION_HOURS=24

# Neon Object Storage (AWS S3-compatible) Configuration
# Retrieved from `neon deploy` or `neon env pull`
AWS_ACCESS_KEY_ID=your-neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-access-key
AWS_ENDPOINT_URL_S3=https://your-branch-storage.aws.neon.tech
AWS_REGION=us-east-2
STORAGE_BUCKET_NAME=lab-photos

# Frontend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PORT=3000
